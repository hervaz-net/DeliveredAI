# Copy to server/.env or export in your shell.
PORT=4000
# Required in production. A long random string used to sign session tokens.
JWT_SECRET=
# Where the SQLite file lives (defaults to server/data/deliveredai.db)
DATABASE_PATH=
# Admin account created on first boot
ADMIN_EMAIL=admin@deliveredai.local
ADMIN_PASSWORD=change-me-now
# Set to "production" to serve the built frontend and use secure cookies
NODE_ENV=development
